generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANCY MODELS
// ============================================

// Organization/Tenant - Mandant/Kunde
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique  // z.B. "acme-corp"
  domain      String?  @unique  // z.B. "acme-corp.com" für Email-basierte Auto-Join
  settings    Json?    // Tenant-spezifische Einstellungen
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  testPlans   TestPlan[]
  workflows   Workflow[]
  testRuns    TestRun[]
  apiKeys     ApiKey[]

  @@map("organizations")
}

// User - Benutzer mit Authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          UserRole  @default(USER)
  orgId         String
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]
  sessions      Session[]

  @@index([orgId])
  @@index([email])
  @@map("users")
}

enum UserRole {
  ADMIN        // Org-Admin: Volle Rechte in Organisation
  MANAGER      // Kann Prüfpläne erstellen/bearbeiten
  USER         // Kann Prüfungen durchführen
  VIEWER       // Nur Lesezugriff
}

// Session - für JWT-Alternative / Session Management
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ApiKey - für API-Zugriff
model ApiKey {
  id          String   @id @default(cuid())
  orgId       String
  name        String   // z.B. "Production API Key"
  keyHash     String   @unique
  lastUsedAt  DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

// AuditLog - für Compliance (GMP, IATF, etc.)
model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  userId      String?
  action      String   // "test_plan.created", "test.executed"
  entityType  String   // "TestPlan", "TestRun"
  entityId    String
  changes     Json?    // Old vs New values
  metadata    Json?    // IP, UserAgent, etc.
  timestamp   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ============================================
// PRÜFPLAN MODELS (mit Multi-Tenancy)
// ============================================

// Prüfplan - definiert welche Prüfungen durchgeführt werden sollen
model TestPlan {
  id          String      @id @default(cuid())
  orgId       String      // Multi-Tenancy
  name        String
  description String?
  category    DocumentCategory // Zeichnung, Etikett, Rechnung
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  procedures  Procedure[]
  testRuns    TestRun[]

  @@index([orgId])
  @@index([orgId, active])
  @@map("test_plans")
}

enum DocumentCategory {
  TECHNICAL_DRAWING // Technische Zeichnung
  LABEL            // Etikett
  INVOICE          // Rechnung
}

// Prozedur - eine Sammlung von Prüfschritten
model Procedure {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int      @default(0)
  testPlanId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testPlan    TestPlan        @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  steps       ProcedureStep[]

  @@map("procedures")
}

// Prüfschritt - einzelner Prüfschritt innerhalb einer Prozedur
model ProcedureStep {
  id           String          @id @default(cuid())
  name         String
  description  String
  checkType    CheckType
  parameters   Json            // Flexible Parameter je nach CheckType
  order        Int             @default(0)
  required     Boolean         @default(true)
  procedureId  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  procedure    Procedure       @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  testResults  TestResult[]

  @@map("procedure_steps")
}

enum CheckType {
  PRESENCE       // Vorhandensein prüfen
  FIELD_VALUE    // Feldwert validieren
  LEGAL_REQUIREMENT // Gesetzliche Vorgabe
  DIN_STANDARD   // DIN-Norm
  IMAGE_QUALITY  // Bildqualität
  TEXT_EXTRACTION // Text-Extraktion und Validierung
  CUSTOM         // Benutzerdefiniert
}

// Prüfung - eine Instanz der Prüfung eines PDFs
model TestRun {
  id              String        @id @default(cuid())
  orgId           String        // Multi-Tenancy
  testPlanId      String
  workflowId      String?       // Optional: Workflow-basierte Prüfung
  fileName        String
  filePath        String
  fileSize        Int
  status          TestStatus    @default(PENDING)
  startedAt       DateTime      @default(now())
  completedAt     DateTime?

  organization    Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  testPlan        TestPlan           @relation(fields: [testPlanId], references: [id])
  workflow        Workflow?          @relation(fields: [workflowId], references: [id])
  testReport      TestReport?
  testResults     TestResult[]
  workflowExecution WorkflowExecution?

  @@index([orgId])
  @@index([orgId, status])
  @@index([testPlanId])
  @@map("test_runs")
}

enum TestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// Prüfprotokoll - das finale Ergebnis einer Prüfung
model TestReport {
  id              String        @id @default(cuid())
  testRunId       String        @unique
  overallResult   ResultStatus
  summary         String?
  metadata        Json?         // Zusätzliche Informationen
  createdAt       DateTime      @default(now())

  testRun         TestRun       @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  @@map("test_reports")
}

// Einzelnes Prüfergebnis
model TestResult {
  id              String        @id @default(cuid())
  testRunId       String
  stepId          String
  result          ResultStatus
  message         String?
  details         Json?         // Detaillierte Ergebnisse vom LLM
  createdAt       DateTime      @default(now())

  testRun         TestRun       @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  step            ProcedureStep @relation(fields: [stepId], references: [id])

  @@map("test_results")
}

enum ResultStatus {
  PASSED
  FAILED
  WARNING
  NOT_APPLICABLE
}

// ============================================
// WORKFLOW ENGINE
// ============================================

// Workflow - Template für die Orchestrierung von Prüfungen
model Workflow {
  id              String        @id @default(cuid())
  orgId           String        // Multi-Tenancy
  name            String
  description     String?
  category        DocumentCategory
  version         Int           @default(1)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodes           WorkflowNode[]
  edges           WorkflowEdge[]
  executions      WorkflowExecution[]
  testRuns        TestRun[]

  @@index([orgId])
  @@index([orgId, active])
  @@map("workflows")
}

// WorkflowNode - Einzelner Knoten im Workflow
model WorkflowNode {
  id              String           @id @default(cuid())
  workflowId      String
  name            String
  description     String?
  nodeType        WorkflowNodeType
  config          Json             // Node-spezifische Konfiguration
  position        Json?            // Position für UI (x, y)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workflow        Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  outgoingEdges   WorkflowEdge[]   @relation("SourceNode")
  incomingEdges   WorkflowEdge[]   @relation("TargetNode")
  executions      WorkflowNodeExecution[]

  @@map("workflow_nodes")
}

enum WorkflowNodeType {
  START              // Start-Knoten
  END                // End-Knoten
  TEST_STEP          // Prüfschritt ausführen
  PARALLEL_GATEWAY   // Parallele Ausführung starten
  PARALLEL_JOIN      // Parallele Ausführung zusammenführen
  CONDITION          // Bedingte Verzweigung
  WAIT               // Warten auf externe Eingabe
}

// WorkflowEdge - Verbindung zwischen Knoten
model WorkflowEdge {
  id              String        @id @default(cuid())
  workflowId      String
  sourceNodeId    String
  targetNodeId    String
  condition       Json?         // Optionale Bedingung für die Aktivierung
  label           String?       // Label für UI
  createdAt       DateTime      @default(now())

  workflow        Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceNode      WorkflowNode  @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode      WorkflowNode  @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@map("workflow_edges")
}

// WorkflowExecution - Laufende Workflow-Instanz
model WorkflowExecution {
  id              String                  @id @default(cuid())
  workflowId      String
  testRunId       String                  @unique
  status          WorkflowExecutionStatus @default(PENDING)
  currentNodeId   String?                 // Aktuell aktiver Knoten
  variables       Json?                   // Workflow-Variablen
  startedAt       DateTime                @default(now())
  completedAt     DateTime?
  error           String?

  workflow        Workflow                @relation(fields: [workflowId], references: [id])
  testRun         TestRun                 @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  nodeExecutions  WorkflowNodeExecution[]

  @@map("workflow_executions")
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  WAITING        // Wartet auf externe Eingabe
  COMPLETED
  FAILED
  CANCELLED
}

// WorkflowNodeExecution - Ausführungsstatus einzelner Knoten
model WorkflowNodeExecution {
  id                String                    @id @default(cuid())
  executionId       String
  nodeId            String
  status            WorkflowNodeExecutionStatus @default(PENDING)
  input             Json?                     // Input-Daten
  output            Json?                     // Output-Daten
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?

  execution         WorkflowExecution         @relation(fields: [executionId], references: [id], onDelete: Cascade)
  node              WorkflowNode              @relation(fields: [nodeId], references: [id])

  @@map("workflow_node_executions")
}

enum WorkflowNodeExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}
